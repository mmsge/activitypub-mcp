# Your domain name (where this server is publicly accessible)
APP_DOMAIN=yourdomain.com

# The ActivityPub username for this bot actor
APP_USERNAME=bot

# Display name for the actor
APP_DISPLAY_NAME=My ActivityPub Bot

# PostgreSQL connection string
DATABASE_URL=postgres://apuser:changepassword@db:5432/activitypub

# Comma-separated list of ActivityPub handles to follow
# These are synced on every server startup
# Examples: @user@mastodon.social,@reader@bookwyrm.social,@photos@pixelfed.social
FOLLOW_ACTORS=

# Admin password hash (generate with: npm run create-admin <your-password>)
ADMIN_PASSWORD_HASH=

# Session secret — must be at least 32 characters, random hex string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# REST API key — required to enable the read-only REST API at /api/v1 (returns the
# same data as the MCP server). Clients send it as "Authorization: Bearer <key>" or
# "X-API-Key: <key>". Leave blank to keep the REST API disabled (it returns 503).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REST_API_KEY=

# Last.fm scrobble ingestion
# API key from https://www.last.fm/api/account/create and the username to sync.
# Both must be set for scrobbles to be ingested; leave blank to disable.
LASTFM_API_KEY=
LASTFM_USERNAME=
# How often to poll Last.fm for new scrobbles, in seconds (default 60, minimum 15).
# Each sync is a single lightweight API call, so frequent polling is fine.
LASTFM_SYNC_INTERVAL_SECONDS=60

# Server port (Caddy proxies to this)
PORT=3000

# Logging
LOG_LEVEL=info
NODE_ENV=production
