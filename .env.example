# Your domain name (where this server is publicly accessible)
APP_DOMAIN=yourdomain.com

# The ActivityPub username for this bot actor
APP_USERNAME=bot

# Display name for the actor
APP_DISPLAY_NAME=My ActivityPub Bot

# PostgreSQL connection string
DATABASE_URL=postgres://apuser:changepassword@db:5432/activitypub

# Comma-separated list of ActivityPub handles to follow
# These are synced on every server startup
# Examples: @user@mastodon.social,@reader@bookwyrm.social,@photos@pixelfed.social
FOLLOW_ACTORS=

# Admin password hash (generate with: npm run create-admin <your-password>)
ADMIN_PASSWORD_HASH=

# Session secret — must be at least 32 characters, random hex string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# API key for header-based access. Required to enable the read-only REST API at /api/v1
# (blank => /api/v1 returns 503). Also accepted as a static "Authorization: Bearer <key>"
# or "X-API-Key: <key>" credential for the MCP server at /mcp — the path used by the
# Claude Code CLI and Claude Desktop. Leave blank to disable that path; /mcp stays
# protected by OAuth (browser/mobile clients like the claude.ai connector), which gates
# its login step behind ADMIN_PASSWORD_HASH above.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REST_API_KEY=

# Last.fm scrobble ingestion
# API key from https://www.last.fm/api/account/create and the username to sync.
# Both must be set for scrobbles to be ingested; leave blank to disable.
LASTFM_API_KEY=
LASTFM_USERNAME=
# How often to poll Last.fm for new scrobbles, in seconds (default 60, minimum 15).
# Each sync is a single lightweight API call, so frequent polling is fine.
LASTFM_SYNC_INTERVAL_SECONDS=60

# BookWyrm reading-history backfill.
# Comma-separated BookWyrm actors (handles or actor URLs) whose full outbox is
# walked on startup + every 6h to ingest started/finished/review/rating posts,
# closing finish-date gaps that predate the follow. Usually also in FOLLOW_ACTORS;
# listed here so only known book-shaped actors get a full outbox crawl. Powers
# get_reading_stats. Example: @reader@bookwyrm.social
BOOKWYRM_ACTORS=

# Optional Google Books API key, used as a by-ISBN enrichment fallback (cover,
# description, subjects, pages, language) when the BookWyrm Edition and OpenLibrary
# leave gaps. OpenLibrary is tried first and needs no key. Leave blank to fall back
# keyless (more rate-limited).
GOOGLE_BOOKS_API_KEY=

# One-time backfill switch. Set to true for a single deploy to make the book-metadata
# sync ignore its 30-day freshness filter and re-enrich every referenced book at once
# (so newly-added fields like cover/description/subjects populate immediately). Unset
# it again afterwards to restore normal staleness-based refresh.
BOOKMETA_BACKFILL=

# Live engagement tools (get_engagement / get_engagement_trends).
# Hostname (or URL) of YOUR Mastodon instance, e.g. skvip.lol. Bare numeric status
# ids passed to get_engagement resolve against it, and MASTODON_ACCESS_TOKEN is only
# ever sent to this host. Leave blank to require full URLs and skip auth entirely.
OWNER_INSTANCE=
# Optional API token for OWNER_INSTANCE — only needed if that instance disallows
# unauthenticated API reads (DISALLOW_UNAUTHENTICATED_API_ACCESS).
MASTODON_ACCESS_TOKEN=
# Max statuses per get_engagement call (default 50).
ENGAGEMENT_MAX_BATCH=50
# Per-request timeout for origin-instance reads, in milliseconds (default 10000).
ENGAGEMENT_HTTP_TIMEOUT_MS=10000
# Background sampler: every N minutes (default 60, min 5) snapshot engagement for the
# owner's most recent posts (OWNER_ACTOR must be set), skipping unchanged counts.
ENGAGEMENT_SAMPLE_INTERVAL_MINUTES=60
# How many recent posts the sampler tracks (default 20, max 50). 0 disables sampling.
ENGAGEMENT_SAMPLE_RECENT_POSTS=20

# Server port (Caddy proxies to this)
PORT=3000

# Logging
LOG_LEVEL=info
NODE_ENV=production
