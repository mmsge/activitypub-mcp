# Your domain name (where this server is publicly accessible)
APP_DOMAIN=yourdomain.com

# The ActivityPub username for this bot actor
APP_USERNAME=bot

# Display name for the actor
APP_DISPLAY_NAME=My ActivityPub Bot

# PostgreSQL connection string
DATABASE_URL=postgres://apuser:changepassword@db:5432/activitypub

# Comma-separated list of ActivityPub handles to follow
# These are synced on every server startup
# Examples: @user@mastodon.social,@reader@bookwyrm.social,@photos@pixelfed.social
FOLLOW_ACTORS=

# Admin password hash (generate with: npm run create-admin <your-password>)
ADMIN_PASSWORD_HASH=

# Session secret — must be at least 32 characters, random hex string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Server port (Caddy proxies to this)
PORT=3000

# Logging
LOG_LEVEL=info
NODE_ENV=production

# ── Semantic search (pgvector + local embedding model) ───────────────────────
# Embeddings are generated in-process by a small transformers.js model — no
# external service or API key. Set EMBEDDING_ENABLED=false to disable the model
# entirely (saves memory); search_actor_content then uses keyword matching only.
EMBEDDING_ENABLED=true
# HuggingFace model id. Default is all-MiniLM-L6-v2 (384 dimensions).
# Changing the model/dimension requires a matching migration for the vector(N)
# column, so keep EMBEDDING_DIMENSIONS in sync with the model.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
# Weight quantization: q8 (low memory) or fp32 (more accurate, more memory).
EMBEDDING_DTYPE=q8
# Where model weights are cached (mount a volume here — see docker-compose.yml).
EMBEDDING_CACHE_DIR=/app/.cache/embeddings
