# Your domain name (where this server is publicly accessible)
APP_DOMAIN=yourdomain.com

# The ActivityPub username for this bot actor
APP_USERNAME=bot

# Display name for the actor
APP_DISPLAY_NAME=My ActivityPub Bot

# How often the bot publishes a status note about its own archive, in hours
# (default 168 — weekly). These notes are the only thing it ever posts: they give the
# account something real to show in its outbox, on its profile page and — for the
# pinned intro — in the `featured` collection Mastodon reads on every profile refresh.
# An unchanged status never reposts regardless of this value. 0 disables them and
# leaves only the pinned intro note.
STATUS_NOTE_INTERVAL_HOURS=168

# PostgreSQL connection string
DATABASE_URL=postgres://apuser:changepassword@db:5432/activitypub

# Comma-separated list of ActivityPub handles to follow
# These are synced on every server startup
# Examples: @user@mastodon.social,@reader@bookwyrm.social,@photos@pixelfed.social
FOLLOW_ACTORS=

# Admin password hash (generate with: npm run create-admin <your-password>)
ADMIN_PASSWORD_HASH=

# Session secret — must be at least 32 characters, random hex string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# API key for header-based access. Required to enable the read-only REST API at /api/v1
# (blank => /api/v1 returns 503). Also accepted as a static "Authorization: Bearer <key>"
# or "X-API-Key: <key>" credential for the MCP server at /mcp — the path used by the
# Claude Code CLI and Claude Desktop. Leave blank to disable that path; /mcp stays
# protected by OAuth (browser/mobile clients like the claude.ai connector), which gates
# its login step behind ADMIN_PASSWORD_HASH above.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REST_API_KEY=

# Last.fm scrobble ingestion
# API key from https://www.last.fm/api/account/create and the username to sync.
# Both must be set for scrobbles to be ingested; leave blank to disable.
LASTFM_API_KEY=
LASTFM_USERNAME=
# How often to poll Last.fm for new scrobbles, in seconds (default 60, minimum 15).
# Each sync is a single lightweight API call, so frequent polling is fine.
LASTFM_SYNC_INTERVAL_SECONDS=60

# LinkedIn post ingestion (DMA Member Snapshot API)
# Access token for the Member Data Portability (Member) product, scope
# r_dma_portability_self_serve. Minted BY HAND — there is no refresh flow. The
# product is a Digital Markets Act obligation, so only members in the EEA and
# Switzerland can consent and generate one at all. See the LinkedIn section of the
# README for how to mint it. Leave blank to disable the poller; the monthly .xlsx
# import at /admin/import keeps working either way.
#
# Treat the expiry as unknown and possibly short. When it dies the admin dashboard
# shows a red "Token refused" badge and get_linkedin_stats reports
# source_health.token_status = "unauthorized" — you do not have to read logs to
# find out. Re-mint, put it here, and run `npm run sync-linkedin` to confirm.
LINKEDIN_DMA_TOKEN=
# How often to re-crawl the snapshot, in hours (default 168 = weekly, minimum 1).
# The snapshot is historical and complete on every call rather than a feed of
# changes, so nothing is missed between runs and weekly is plenty.
LINKEDIN_SYNC_INTERVAL_HOURS=168

# ── YouTube Shorts classification ────────────────────────────────────────────────
# The watch history carries no Shorts flag — every row has a /watch?v= URL, because My
# Activity does not distinguish them, and the Data API exposes neither a flag nor aspect
# ratio. So one is derived, in three stages, cheapest first. See ADR 0049.
#
# How often to run the classifier, in hours. 0 disables the timer. Leaving it on costs
# nothing once the archive is settled: both work queues are partial indexes, so a run with
# nothing to do reads no rows. Stage 0 is offline and free and settles about a third of the
# archive on its own, so this is useful even with no API key at all.
YOUTUBE_SHORTS_INTERVAL_HOURS=6

# YouTube Data API v3 key, for stage 1 (videos.list). BLANK DISABLES STAGE 1 — the same
# deploy-then-arm shape as LASTFM_API_KEY. Stage 1 fetches the real UPLOAD date, which is
# what makes the era rules exact instead of merely bounded by the watch date; it also
# persists title, channel and category on the way past.
#   https://console.cloud.google.com/apis/credentials -> API key, enable "YouTube Data API v3"
YOUTUBE_API_KEY=

# Maximum videos.list calls per run. Each call covers 50 ids and costs ONE quota unit
# against a 10,000/day allowance, so 200 units buys 10,000 videos and the whole ~92k
# backlog is about 1,846 units — it fits inside one day with room to spare. To drain it in
# a single pass rather than waiting for the timer:
#   npm run classify-youtube-shorts -- --max-api-calls=1900
YOUTUBE_SHORTS_MAX_API_CALLS_PER_RUN=200

# Stage 2, the HTTP probe: request https://www.youtube.com/shorts/<id> and see whether it
# stays there or redirects to /watch. It is the ONLY stage that can confirm a Short —
# nothing YouTube serves as metadata proves one — and it is also the expensive one.
#
# YouTube returned HTTP 429 after TWO requests. Not two thousand. At one request every two
# seconds a band of 50,000 videos takes about 29 hours, so this is off by default and meant
# to be armed only once the residual after stage 1 is known and judged worth it. Leaving it
# off simply leaves those rows labelled as guesses, which the tools report honestly.
YOUTUBE_SHORTS_PROBE_ENABLED=false
YOUTUBE_SHORTS_MAX_PROBES_PER_RUN=100
YOUTUBE_SHORTS_PROBE_SPACING_MS=2000

# ntfy push notifications (https://n.msge.no). There is ONE shared `markus` password
# on the box; it must match ntfy's user.db and every other publisher's copy, or the
# pushes 401 silently — see hetzner-server ADR 0011 and services/ntfy.md. Compare
# lengths without printing the secret:
#   awk -F= '/^NTFY_PASSWORD=/{print length($2)}' /srv/bot/.env
# Blank NTFY_PASSWORD disables every push feature. This service is its own Compose
# project, so it is NOT on ntfy's internal network and publishes over public HTTPS.
NTFY_URL=https://n.msge.no
NTFY_TOPIC=scrobble-race
NTFY_USER=markus
NTFY_PASSWORD=
# Second topic, for the breakout alerts (see BREAKOUT_* further down). Its own topic so
# the race countdown and the post alerts can be muted independently on the phone.
NTFY_TOPIC_BREAKOUT=tut-treff

# Head-to-head scrobble race: watch one artist close on another and push an alert as
# the gap shrinks — a milestone ladder, then an alert per play once it's close, then
# a live "the song playing right now is the one" alert, then the overtake.
# Both names must match scrobbles.artist_name EXACTLY (no substring matching).
# Leave either blank to disable both race jobs.
RACE_LEADER_ARTIST=Taylor Swift
RACE_CHALLENGER_ARTIST=Maisie Peters
# Gaps that each fire a one-off milestone alert, on the way down only.
RACE_MILESTONES=300,250,200,150,100,75,50,25,20,15,10
# The endgame countdown band. At or below this gap the ladder stands down and every
# challenger play that moves the number gets its own alert instead — "9 to go", "8 to
# go", one per play, never one per poll. Widen it to get more warning; the alerts land
# 15-20s into the track that triggered them, so 5 or 10 buys real margin where 1 or 2
# would not. 0 switches the countdown off and leaves you the ladder.
#
# It does NOT gate the three decisive alerts — gap 1 ("one more levels it"), gap 0
# ("the next track takes it") and the overtake itself. Those are the finish rather than
# the countdown and fire at any value, including 0. See decision records 0016 and 0022.
RACE_COUNTDOWN_GAP=10
# Gap at or below which the live now-playing watcher arms, naming the track playing
# right now as the one about to tie or win. 0 (the default) disables it.
#
# ONLY enable this if your scrobbler sends Last.fm the `track.updateNowPlaying` call.
# That is a separate submission from the scrobble, and many players never make it —
# scrobbling can work perfectly while now-playing is silent. Check first: play
# something, then confirm get_now_playing returns nowPlaying:true. If it doesn't, this
# job polls Last.fm forever for a signal that never comes. The armed alerts at gap 1
# and gap 0 cover the same ground from scrobbles alone, so you lose little.
#
# Called RACE_ENDGAME_GAP before decision record 0022 — "endgame" now means the
# countdown band above, which is what get_scrobble_race reports as endgame_gap.
RACE_NOWPLAYING_GAP=0
RACE_NOWPLAYING_INTERVAL_SECONDS=30

# BookWyrm reading-history backfill.
# Comma-separated BookWyrm actors (handles or actor URLs) whose full outbox is
# walked on startup + every 6h to ingest started/finished/review/rating posts,
# closing finish-date gaps that predate the follow. Usually also in FOLLOW_ACTORS;
# listed here so only known book-shaped actors get a full outbox crawl. Powers
# get_reading_stats. Example: @reader@bookwyrm.social
BOOKWYRM_ACTORS=

# Optional Google Books API key, used as a by-ISBN enrichment fallback (cover,
# description, subjects, pages, language) when the BookWyrm Edition and OpenLibrary
# leave gaps. OpenLibrary is tried first and needs no key. Leave blank to fall back
# keyless (more rate-limited).
GOOGLE_BOOKS_API_KEY=

# One-time backfill switch. Set to true for a single deploy to make the book-metadata
# sync ignore its 30-day freshness filter and re-enrich every referenced book at once
# (so newly-added fields like cover/description/subjects populate immediately). Unset
# it again afterwards to restore normal staleness-based refresh.
BOOKMETA_BACKFILL=

# NeoDB catalogue enrichment (get_watched / get_catalogue_details). Staleness window
# in days — a cached catalog item is refetched only when older than this, previously
# errored, or forced. Default 30.
NEODB_STALE_DAYS=
# One-time backfill switch (mirrors BOOKMETA_BACKFILL). Set to true for a single deploy
# to make the NeoDB sync ignore the staleness window and re-enrich every referenced
# catalog item at once, so new fields/categories populate immediately. Unset afterwards.
NEODB_BACKFILL=

# Live engagement tools (get_engagement / get_engagement_trends).
# Hostname (or URL) of YOUR Mastodon instance, e.g. skvip.lol. Bare numeric status
# ids passed to get_engagement resolve against it, and MASTODON_ACCESS_TOKEN is only
# ever sent to this host. Leave blank to require full URLs and skip auth entirely.
OWNER_INSTANCE=
# Optional API token for OWNER_INSTANCE — only needed if that instance disallows
# unauthenticated API reads (DISALLOW_UNAUTHENTICATED_API_ACCESS).
MASTODON_ACCESS_TOKEN=
# Max statuses per get_engagement call (default 50).
ENGAGEMENT_MAX_BATCH=50
# Per-request timeout for origin-instance reads, in milliseconds (default 10000).
ENGAGEMENT_HTTP_TIMEOUT_MS=10000
# Background sampler: every N minutes (default 60, min 5) snapshot engagement for the
# owner's most recent posts (OWNER_ACTOR must be set), skipping unchanged counts.
ENGAGEMENT_SAMPLE_INTERVAL_MINUTES=60
# How many recent posts the sampler tracks (default 20, max 50). 0 disables sampling.
# NOTE this is also the horizon of the breakout alerts below: a post that goes viral
# after 20 newer ones have been published is no longer sampled and can no longer fire.
ENGAGEMENT_SAMPLE_RECENT_POSTS=20

# --- Breakout alerts: "this post is doing better than your usual" (ADR 0036) ---
# Pushes an ntfy alert when one of your posts passes the p90 of your OWN recent posts,
# then p99, then your all-time record — three rungs, each firing once and never
# re-arming — plus one low-priority digest in the evening. Reads the engagement the
# sampler above already collects; only the fast lane spends remote API calls.
#
# OFF by default. Deploy the code, look at /admin/breakouts to check where each
# account's bar actually sits, and only then set this to 1. The first run after you do
# is silent by design: it records where every post already stands rather than replaying
# your history into your phone.
BREAKOUT_ENABLED=
# Score = favourites*w1 + reblogs*w2 + replies*w3. A boost weighs most (it reaches an
# audience that wasn't there), a reply next (it costs effort), a favourite least.
# Changing any of these re-scores your whole archive; that is handled as a silent
# re-seed rather than fifty simultaneous breakouts, but the bar will move.
BREAKOUT_WEIGHT_FAVOURITES=1
BREAKOUT_WEIGHT_REBLOGS=3
BREAKOUT_WEIGHT_REPLIES=2
# Rolling window (days, min 7) the p90/p99 bar is computed over. The record rung is
# deliberately NOT windowed — a personal best is a personal best.
BREAKOUT_BASELINE_DAYS=90
# How far back the hourly pass still considers a post a candidate. Longer than the fast
# lane's window because a post can take off days later off one big boost.
BREAKOUT_CANDIDATE_DAYS=30
# Two guards against a quiet baseline, and you want both. MIN_POSTS refuses to arm an
# account with fewer scored posts in the window (a p99 over 8 posts is "best of 8");
# MIN_SCORE is an absolute floor every rung must clear, because after a quiet fortnight
# a p90 of 2 is arithmetic rather than a compliment.
BREAKOUT_MIN_POSTS=20
BREAKOUT_MIN_SCORE=10
# Which object types count. This is the sampler's list minus GeneratedNote — BookWyrm's
# "Markus finished reading X" boilerplate gets almost no engagement, and including it
# drags that account's percentiles toward zero.
BREAKOUT_OBJECT_TYPES=Note,Question,Article,Page,Image,Video,Comment,Review
# Include your replies in the bar and as candidates. Off by default, matching
# get_actor_engagement_trends: a reply's reach isn't comparable to an original's.
BREAKOUT_INCLUDE_REPLIES=
# Which accounts to watch (@user@domain or actor URLs, comma-separated). Blank means
# every accepted follow — i.e. all your accounts. Set it to exclude one without
# unfollowing it.
BREAKOUT_ACTORS=
# The fast lane: re-read engagement for posts published in the last N hours every N
# minutes, so a post taking off is caught while it is still happening rather than up to
# an hour later. THIS IS THE ONLY PART THAT SPENDS REMOTE API CALLS — worst case
# MAX_POSTS per account per tick, and nothing at all on a day you haven't posted.
# 0 disables the fast lane and leaves the hourly pass. To spend less, cut MAX_POSTS
# rather than lengthening the interval: the value is entirely in a post's first hours.
BREAKOUT_FAST_LANE_MINUTES=10
BREAKOUT_FAST_LANE_HOURS=24
BREAKOUT_FAST_LANE_MAX_POSTS=10
# Hour of day (Europe/Oslo) for the daily digest. -1 disables it. A day with nothing to
# report sends no push at all — a nightly "ingenting skjedde" would just train you to
# mute the topic.
BREAKOUT_DIGEST_HOUR=21

# --- Public stream (meg.msge.no) ---------------------------------------------
# The app serves two sites on one port, routed on the Host header: bot.skvip.lol
# (ActivityPub actor, admin, MCP) and this one — a public, unauthenticated page
# republishing Markus' own public posts. See ADR 0018.
#
# UNSET DISABLES THE STREAM ENTIRELY: no route answers and nothing is published.
# That is the off-switch. Deploy with it empty, check /admin/visibility against the
# real data, and only then set it.
STREAM_DOMAIN=
# Which accounts may appear, as `@user@domain|platform` separated by commas.
# Platform is one of: mastodon, bookwyrm, pixelfed, loops, neodb, rullen, samklang.
# `samklang` is Gigowl's NodeInfo software name, which did not change when the service
# rebranded and moved to gigowl.social — so the concert log is @you@gigowl.social|samklang.
#
# This is an ALLOWLIST, not a convenience. `objects` also holds posts by other
# people — the Announce handler files a boosted post under its original author — so
# nothing may be published that is not from an account named here. A malformed entry
# is a startup error rather than a silent skip.
STREAM_SOURCES=
# Include unlisted posts alongside public ones. Off unless set to 1/true/yes/on.
# Unlisted means the author kept it off public timelines; an indexed page is the
# opposite of that, so leave this alone unless you mean it.
STREAM_INCLUDE_UNLISTED=
# How far back the daily music digests go, in months (default 12; 0 keeps every day).
# ~51k scrobbles since 2016 is more daily digests than there are posts, and without a
# cutoff the deep archive reads as a listening log.
STREAM_SCROBBLE_CUTOFF_MONTHS=12
# How long a rendered page may be served from cache, in seconds (default 180).
STREAM_CACHE_TTL_SECONDS=180
# Disk budget for proxied images, in MB. 0 disables the proxy and the page goes
# back to hotlinking from the origin CDNs. Lives in the image_cache volume.
STREAM_IMAGE_CACHE_MB=250
STREAM_IMAGE_CACHE_DIR=/data/images

# Server port (Caddy proxies to this)
PORT=3000

# Logging
LOG_LEVEL=info
NODE_ENV=production
